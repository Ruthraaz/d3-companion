# Copie este arquivo para .env e ajuste os valores para o seu PC.
# O .env fica fora do Git (veja .gitignore).

# Caminho do executável do Tesseract. Se não definir, o app usa este padrão.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Tecla que avalia o item sob o mouse. Padrão: F8.
# Exemplos: F8, F9, Ctrl+F8, Alt+F8, Shift+Q, Insert, Pause.
ATALHO=F8

# Quantos segundos o selo do atalho fica na tela. Padrão: 6.
SELO_SEGUNDOS=6

# Build usada na avaliação: nome do arquivo em builds/ sem o .json
# (ex.: legacy_of_nightmares). Vazio = avalia com todas. A janela troca isso sozinha.
BUILD_ATIVA=

# Avaliar sozinho ao passar o mouse num item (sim) ou só pelo atalho (nao). Padrão: sim.
# Com "sim" o selo fica enquanto a dica estiver na tela; o atalho continua funcionando.
AUTOMATICO=sim

# Chaves da API da Blizzard: OPCIONAIS. Sem elas o app usa o servidor do D3 Companion.
# Pra usar as suas: https://develop.battle.net -> API Access -> Create Client.
# São como senha: só aqui no .env, nunca no Git. Teste com: python src/blizzard.py
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
